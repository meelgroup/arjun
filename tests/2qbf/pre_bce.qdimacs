c clause 1 is blocked on 3, then clause 2 on 4: nothing is left, so true
c RUN: %arjun --2qbfpre --cover 0 --synthpuura 0 --prerepairs 0 %s %t.out > %t.log; test $? -eq 10
c RUN: grep -v "^c" %t.out | tr "\n" " " | grep -q "^p cnf 4 0 $"
c without it the clauses come back as they are
c RUN: %arjun --2qbfpre --cover 0 --synthpuura 0 --prerepairs 0 --prebce 0 %s %t.out > %t.log; test $? -eq 0
c RUN: grep -v "^c" %t.out | tr "\n" " " | grep -q "^p cnf 4 2 a 1 2 0 e 3 4 0 1 3 0 2 -3 4 0 $"
p cnf 4 2
a 1 2 0
e 3 4 0
1 3 0
2 -3 4 0
