c nothing runs, so the file comes back as it is, variable numbers kept
c RUN: %arjun --2qbfpre --cover 0 --synthbve 0 %s %t.out > %t.log; test $? -eq 0
c RUN: grep -v "^c" %t.out | tr "\n" " " | grep -q "^p cnf 5 3 a 2 4 0 e 3 5 0 2 -3 5 0 -2 3 0 4 -5 0 $"
c RUN: %arjun --2qbf %t.out > %t.log2; test $? -eq 10
p cnf 5 3
a 2 4 0
e 3 5 0
2 -3 5 0
-2 3 0
4 -5 0
