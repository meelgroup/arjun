c the functions written out work for every universal assignment, whether
c covering or synthesis made them
c RUN: %arjun --2qbf --cover 0 %s %t.aig > %t.log; test $? -eq 10
c RUN: %test_synth -u -q %s %t.aig | grep -q "verified CORRECT"
c RUN: %arjun --2qbf --cover 50 %s %t.aig > %t.log; test $? -eq 10
c RUN: %test_synth -u -q %s %t.aig | grep -q "verified CORRECT"
