c an empty clause: any universal assignment is a counterexample
c RUN: %expect_exit 20 %arjun --2qbf --cover 0 %s > %t.log
c RUN: grep "^[sV]" %t.log | tr "\n" " " | grep -q "^s cnf 0 2 1 V -1 0 $"
c RUN: %expect_exit 20 %arjun --2qbf --cover 50 %s > %t.log
c RUN: grep "^[sV]" %t.log | tr "\n" " " | grep -q "^s cnf 0 2 1 V -1 0 $"
p cnf 2 1
a 1 0
e 2 0
0
