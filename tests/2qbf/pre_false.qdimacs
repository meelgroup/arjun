c preprocessing solves it: false is a file with the empty clause, like bloqqer's
c RUN: %arjun --2qbfpre %s %t.out > %t.log; test $? -eq 20
c RUN: grep -v "^c" %t.out | tr "\n" " " | grep -q "^p cnf 3 1 0 $"
c RUN: grep "^[sV]" %t.log | tr "\n" " " | grep -q "^s cnf 0 3 3 V 1 0 V -2 0 $"
p cnf 3 3
a 1 2 0
e 3 0
-1 3 0
-1 -3 2 0
1 3 0
